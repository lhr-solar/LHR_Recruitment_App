{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "lhr-recruitment",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lhr-recruitment"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// The test site. Wrangler creates the DNS record, as long as test.lhrsolar.org has no A or CNAME
	// record of its own yet.
	"routes": [{ "pattern": "test.lhrsolar.org", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
