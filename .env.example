# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Where the site runs; used for sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (phase 3+): transactional email
RESEND_API_KEY=
# Until the domain is verified in Resend, test with "LHR Careers <onboarding@resend.dev>"
# (Resend only delivers that sender to your own Resend account's address).
EMAIL_FROM="Longhorn Racing Careers <careers@longhornracing.org>"
